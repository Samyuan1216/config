{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build",
            "command": "/usr/bin/g++",
            "args": [
                "-std=gnu++23",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/zsy.out",
                "-Wall",
                "-Werror"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
               "kind": "build",
               "isDefault": true
           },
            "detail": "编译器: g++"
        }
    ]
}
