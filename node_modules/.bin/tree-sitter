#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.deno/tree-sitter-cli@0.26.5/node_modules/tree-sitter-cli/cli.js" "$@"
else
  exec node  "$basedir/../.deno/tree-sitter-cli@0.26.5/node_modules/tree-sitter-cli/cli.js" "$@"
fi
