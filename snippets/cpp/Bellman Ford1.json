			"auto bellman_ford = [&](int s) -> std::optional<std::vector<int>>",
			"{",
			"    std::vector<int> dist(n, 1e9);",
			"    dist[s] = 0;",
			"",
			"    for (int i = 1; i < n; ++i)",
			"    {",
			"        bool update = false;",
			"        for (int u = 0; u < n; ++u)",
			"        {",
			"            for (auto &[v, w]: g[u])",
			"            {",
			"                if (dist[u] != 1e9 && dist[u] + w < dist[v])",
			"                {",
			"                    dist[v] = dist[u] + w;",
			"                    update = true;",
			"                }",
			"            }",
			"        }",
			"",
			"        if (!update)",
			"        {",
			"            break;",
			"        }",
			"    }",
			"",
			"    for (int u = 0; u < n; ++u)",
			"    {",
			"        for (auto &[v, w]: g[u])",
			"        {",
			"            if (dist[u] != 1e9 && dist[u] + w < dist[v])",
			"            {",
			"                return std::nullopt;",
			"            }",
			"        }",
			"    }",
			"",
			"    return dist;",
			"};"
		],
		"description": "Bellman-Ford(Adjacency List)"
	}
