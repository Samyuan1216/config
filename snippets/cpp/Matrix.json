{
	"Print to console": {
		"scope": "cpp",
		"prefix": "Matrix",
		"body": [
			"template<class R>",
			"struct Mat",
			"{",
			"    using T = typename R::T;",
			"",
			"    int n, m;",
			"    std::vector<std::vector<T>> a;",
			"",
			"    Mat(int n = 0, int m = 0, T val = R::zero()): n(n), m(m), a(n, std::vector<T>(m, val)) {}",
			"",
			"    void eye()",
			"    {",
			"        for (int i = 0; i < n; ++i)",
			"        {",
			"            for (int j = 0; j < m; ++j)",
			"            {",
			"                a[i][j] = (i == j? R::one(): R::zero());",
			"            }",
			"        }",
			"    }",
			"",
			"    Mat operator+(const Mat &b) const",
			"    {",
			"        Mat res(n, m);",
			"        for (int i = 0; i < n; ++i)",
			"        {",
			"            for (int j = 0; j < m; ++j)",
			"            {",
			"                res.a[i][j] = R::add(a[i][j], b.a[i][j]);",
			"            }",
			"        }",
			"",
			"        return res;",
			"    }",
			"",
			"    Mat operator*(const Mat &b) const",
			"    {",
			"        Mat res(n, b.m, R::zero());",
			"        for (int i = 0; i < n; ++i)",
			"        {",
			"            for (int k = 0; k < m; ++k)",
			"            {",
			"                if (a[i][k] == R::zero())",
			"                {",
			"                    continue;",
			"                }",
			"",
			"                for (int j = 0; j < b.m; ++j)",
			"                {",
			"                    res.a[i][j] = R::add(res.a[i][j], R::mul(a[i][k], b.a[k][j]));",
			"                }",
			"            }",
			"        }",
			"",
			"        return res;",
			"    }",
			"",
			"    Mat qpow(long long p) const",
			"    {",
			"        Mat res(n, n), base = *this;",
			"        res.eye();",
			"",
			"        while (p > 0)",
			"        {",
			"            if (p & 1)",
			"            {",
			"                res = res * base;",
			"            }",
			"",
			"            base = base * base;",
			"            p >>= 1;",
			"        }",
			"",
			"        return res;",
			"    }",
			"};"
		],
		"description": "矩阵"
	}
}

