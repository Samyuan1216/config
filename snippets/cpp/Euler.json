{
	"Print to console": {
		"scope": "cpp",
		"prefix": "Euler",
		"body": [
			"auto euler = [&](int n) -> std::vector<int>",
			"{",
			"    auto visited = std::vector<bool>(n + 1);",
			"    auto prime = std::vector<int>(n / 2 + 1);",
			"",
			"    int cnt = 0;",
			"    for (int i = 2; i <= n; ++i)",
			"    {",
			"        if (!visited[i])",
			"        {",
			"            prime[cnt++] = i;",
			"        }",
			"",
			"        for (int j = 0; j < cnt; ++j)",
			"        {",
			"            if (i * prime[j] > n)",
			"            {",
			"                break;",
			"            }",
			"",
			"            visited[i * prime[j]] = true;",
			"            if (i % prime[j] == 0)",
			"            {",
			"                break;",
			"            }",
			"        }",
			"    }",
			"",
			"    prime.resize(cnt);",
			"    return prime;",
			"};"
		],
		"description": "欧拉筛"
	}
}
