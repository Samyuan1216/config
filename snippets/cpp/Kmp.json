{
	"Print to console": {
		"scope": "cpp",
		"prefix": "Kmp",
		"body": [
			"auto next_array = [&](std::string &str) -> std::vector<int>",
			"{",
			"    int n = str.length();",
			"    if (n == 1)",
			"    {",
			"        return std::vector<int>{-1};",
			"    }",
			"",
			"    auto next = std::vector<int>(n);",
			"    next[0] = -1;",
			"",
			"    int i = 2, m = 0;",
			"    while (i < n)",
			"    {",
			"        if (str[i - 1] == str[m])",
			"        {",
			"            next[i++] = ++m;",
			"        }",
			"        else if (m > 0)",
			"        {",
			"            m = next[m];",
			"        }",
			"        else",
			"        {",
			"            next[i++] = 0;",
			"        }",
			"    }",
			"",
			"    return next;",
			"};",
			"",
			"auto kmp = [&](std::string &str1, std::string &str2) -> std::optional<int>",
			"{",
			"    int n = str1.length(), m = str2.length(), x = 0, y = 0;",
			"    auto next = next_array(str2);",
			"",
			"    while (x < n && y < m)",
			"    {",
			"        if (str1[x] == str2[y])",
			"        {",
			"            x++, y++;",
			"        }",
			"        else if (y == 0)",
			"        {",
			"            x++;",
			"        }",
			"        else",
			"        {",
			"            y = next[y];",
			"        }",
			"    }",
			"",
			"    return (y == m? std::optional(x - y): std::nullopt);",
			"};"
		],
		"description": "kmp"
	}
}
