{
	"Print to console": {
		"scope": "cpp",
		"prefix": "Kmp",
		"body": [
			"auto next_array = [&](const auto &arr) -> std::vector<int>",
			"{",
			"    int n = std::ssize(arr);",
			"    if (n == 1)",
			"    {",
			"        return std::vector<int>{-1};",
			"    }",
			"",
			"    std::vector<int> next(n);",
			"    next[0] = -1;",
			"",
			"    int i = 2, m = 0;",
			"    while (i < n)",
			"    {",
			"        if (arr[i - 1] == arr[m])",
			"        {",
			"            next[i++] = ++m;",
			"        }",
			"        else if (m > 0)",
			"        {",
			"            m = next[m];",
			"        }",
			"        else",
			"        {",
			"            next[i++] = 0;",
			"        }",
			"    }",
			"",
			"    return next;",
			"};",
			"",
			"auto kmp = [&](const auto &arr1, const auto &arr2) -> std::optional<int>",
			"{",
			"    int n = std::ssize(arr1), m = std::ssize(arr2), x = 0, y = 0;",
			"    auto next = next_array(arr2);",
			"",
			"    while (x < n && y < m)",
			"    {",
			"        if (arr1[x] == arr2[y])",
			"        {",
			"            x++, y++;",
			"        }",
			"        else if (y == 0)",
			"        {",
			"            x++;",
			"        }",
			"        else",
			"        {",
			"            y = next[y];",
			"        }",
			"    }",
			"",
			"    return (y == m? std::optional(x - y): std::nullopt);",
			"};"
		],
		"description": "kmp"
	}
}
