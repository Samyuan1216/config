{
	"Print to console": {
		"scope": "cpp",
		"prefix": "bs1",
		"body": [
			"auto find = [&](auto l, auto r)",
			"{",
			"    std::optional<decltype(l)> ans;",
			"    while (l <= r)",
			"    {",
			"        auto mid = std::midpoint(l, r);",
			"        if (check(mid))",
			"        {",
			"            ans = mid;",
			"            l = mid + 1;",
			"        }",
			"        else",
			"        {",
			"            r = mid - 1;",
			"        }",
			"    }",
			"",
			"    return ans;",
			"};"
		],
		"description": "二分搜索（整数向右）"
	}
}
