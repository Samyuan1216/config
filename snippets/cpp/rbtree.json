{
	"Print to console": {
		"scope": "cpp",
		"prefix": "rb_tree",
		"body": [
			"template<typename T>",
			"struct Item",
			"{",
			"    T val;",
			"    int id;",
			"    inline static int global_id = 0;",
			"",
			"    Item(T v): val(v), id(global_id++) {}",
			"    Item(T v, int i): val(v), id(i) {}",
			"",
			"    bool operator<(const Item &other) const",
			"    {",
			"        if (val != other.val)",
			"        {",
			"            return val < other.val;",
			"        }",
			"",
			"        return id < other.id;",
			"    }",
			"};",
			"",
			"template<typename T1 = int, typename F1 = std::less<Item<T1>>, typename T2 = __gnu_pbds::null_type>",
			"using rb_tree = __gnu_pbds::tree<Item<T1>, T2, F1, __gnu_pbds::rb_tree_tag, __gnu_pbds::tree_order_statistics_node_update>;"
		],
		"description": "红黑树"
	}
}
