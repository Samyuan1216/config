			"    bint pow(u64 x) const",
			"    {",
			"        bint res = 1;",
			"        for (bint a(*this); x != 0; x >>= 1, a *= a)",
			"        {",
			"            if (x & 1)",
			"            {",
			"                res *= a;",
			"            }",
			"        }",
			"        return res;",
			"    }",
			"",
			"    bint root(u64 x) const",
			"    {",
			"        if (sign == 0 || x == 1)",
			"        {",
			"            return *this;",
			"        }",
			"        bint n = *this;",
			"        bint t = BASE;",
			"        bint ret = std::min(n, t.move_l((std::ssize(n.digits) + x) / x));",
			"        int l = 0;",
			"        int r = BASE - 1;",
			"        while (l < r)",
			"        {",
			"            int mid = (l + r) >> 1;",
			"            ret.digits.back() = mid;",
			"            if (ret.pow(x) <= n)",
			"            {",
			"                l = mid + 1;",
			"            }",
			"            else",
			"            {",
			"                r = mid;",
			"            }",
			"        }",
			"        ret.digits.back() = l;",
			"        ret.trim();",
			"        bint x2 = (ret * (x - 1) + n / ret.pow(x - 1)) / x;",
			"        while (x2 < ret)",
			"        {",
			"            std::swap(x2, ret);",
			"            x2 = (ret * (x - 1) + n / ret.pow(x - 1)) / x;",
			"        }",
			"        return ret;",
			"    }",
