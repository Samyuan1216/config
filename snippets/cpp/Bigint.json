		"body": [
			"struct bint",
			"{",
            "private:",
			"    using u32 = std::uint32_t;",
			"    using u64 = std::uint64_t;",
			"",
			"    static constexpr u64 BASE = 1e8;             // 进制数",
			"    static constexpr int BIT = 8;                // 一个数字存储多少位，和进制对应",
			"    static constexpr int FFT_LIMIT = 512;        // 超过阈值后使用 FFT",
			"    static constexpr int NEWTON_LIMIT = 512;     // 超过阈值后使用牛顿迭代",
			"    static constexpr int NEWTON_MIN_LEVEL = 16;  // 牛顿迭代的阈值",
			"",
			"    std::vector<u32> digits;",
			"    int sign = 0;",
			"",
			"    class DivisionByZeroError: public std::exception",
			"    {",
			"    public:",
			"        const char *what() const noexcept override",
			"        {",
			"            return \"binteger::Division By 0\";",
			"        }",
			"    };",
			"",
			"    class FFT",
			"    {",
			"        using comp = std::complex<double>;",
			"        static constexpr int FFT_BASE = 1e4;",
			"        inline static std::vector<comp> w{1.0};",
			"",
			"        static void init(int l)",
			"        {",
			"            int old = std::ssize(w);",
			"            if (l <= (old << 1))",
			"            {",
			"                return;",
			"            }",
			"            int t = std::bit_width(static_cast<u32>(l - 1)) - 1;",
			"            l = 1 << t;",
			"            w[0] = 1.0;",
			"            w.resize(l);",
			"            for (int i = 1; i < l; i <<= 1)",
			"            {",
			"                w[i] = std::polar(1.0, std::numbers::pi / (i << 1));",
			"            }",
			"            for (int i = 1; i < l; i++)",
			"            {",
			"                w[i] = w[i & (i - 1)] * w[i & -i];",
			"            }",
			"        }",
			"",
			"        static void dif(std::vector<comp> &x)",
			"        {",
			"            for (int l = std::ssize(x) >> 1, r = std::ssize(x); l; l >>= 1, r >>= 1)",
			"            {",
			"                for (int k = 0; k < l; ++k)",
			"                {",
			"                    comp a = x[k];",
			"                    comp b = x[k + l];",
			"                    x[k] = a + b;",
			"                    x[k + l] = a - b;",
			"                }",
			"                auto o = w.begin() + 1;",
			"                for (int j = r; j < std::ssize(x); j += r, ++o)",
			"                {",
			"                    for (int k = j; k < j + l; ++k)",
			"                    {",
			"                        comp a = x[k];",
			"                        comp b = x[k + l] * (*o);",
			"                        x[k] = a + b;",
			"                        x[k + l] = a - b;",
			"                    }",
			"                }",
			"            }",
			"        }",
			"",
			"        static void dit(std::vector<comp> &x)",
			"        {",
			"            for (int l = 1, r = 2; l < std::ssize(x); l <<= 1, r <<= 1)",
			"            {",
			"                for (int k = 0; k < l; ++k)",
			"                {",
			"                    comp a = x[k];",
			"                    comp b = x[k + l];",
			"                    x[k] = a + b;",
			"                    x[k + l] = a - b;",
			"                }",
			"                auto o = w.begin() + 1;",
			"                for (int j = r; j < std::ssize(x); j += r, ++o)",
			"                {",
			"                    for (int k = j; k < j + l; ++k)",
			"                    {",
			"                        comp a = x[k];",
			"                        comp b = x[k + l];",
			"                        x[k] = a + b;",
			"                        x[k + l] = (a - b) * std::conj(*o);",
			"                    }",
			"                }",
			"            }",
			"        }",
			"",
			"        static void fconv(std::vector<comp> &x, std::vector<comp> &y)",
			"        {",
			"            init(std::ssize(x));",
			"            dif(x);",
			"            dif(y);",
			"            double fx = 1.0 / std::ssize(x);",
			"            double fx2 = 0.25 * fx;",
			"            x[0] = {x[0].real() * y[0].real() + x[0].imag() * y[0].imag(),",
			"                    x[0].real() * y[0].imag() + x[0].imag() * y[0].real()};",
			"            x[0] *= fx;",
			"            x[1] *= y[1] * fx;",
			"",
			"            for (int k = 2, m = 3; k < std::ssize(x); k <<= 1, m <<= 1)",
			"            {",
			"                for (int i = k, j = i + k - 1; i < m; ++i, j--)",
			"                {",
			"                    comp oi = x[i] + std::conj(x[j]);",
			"                    comp hi = x[i] - std::conj(x[j]);",
			"                    comp Oi = y[i] + std::conj(y[j]);",
			"                    comp Hi = y[i] - std::conj(y[j]);",
			"                    comp r0 = oi * Oi - hi * Hi * ((i & 1) ? -w[i >> 1] : w[i >> 1]);",
			"                    comp r1 = Oi * hi + oi * Hi;",
			"                    x[i] = (r0 + r1) * fx2;",
			"                    x[j] = std::conj(r0 - r1) * fx2;",
			"                }",
			"            }",
			"",
			"            dit(x);",
			"        }",
			"",
			"    public:",
			"        static void mul(std::vector<u32> &a, const std::vector<u32> &b)",
			"        {",
			"            int len1 = std::ssize(a);",
			"            int len2 = std::ssize(b);",
			"            int len = 2 << (std::bit_width(static_cast<u32>(len1 + len2 - 1)) - 1);",
			"            std::vector<comp> x(len, 0.0);",
			"            std::vector<comp> y(len, 0.0);",
			"            for (int i = 0; i < len1; ++i)",
			"            {",
			"                x[i] = comp(a[i] % FFT_BASE, a[i] / FFT_BASE);",
			"            }",
			"            for (int i = 0; i < len2; ++i)",
			"            {",
			"                y[i] = comp(b[i] % FFT_BASE, b[i] / FFT_BASE);",
			"            }",
			"",
			"            FFT::fconv(x, y);",
			"",
			"            a.resize(len1 + len2);",
			"            u64 temp = 0;",
			"            for (int i = 0; i < std::ssize(a); ++i)",
			"            {",
			"                temp += static_cast<u64>(x[i].real() + 0.5) + static_cast<u64>(x[i].imag() + 0.5) * FFT_BASE;",
			"                a[i] = temp % BASE;",
			"                temp /= BASE;",
			"            }",
			"        }",
			"    };",
			"",
			"    void add(const std::vector<u32> &b)",
			"    {",
			"        if (std::ssize(b) > std::ssize(digits))",
			"        {",
			"            digits.resize(b.size());",
			"        }",
			"        for (int i = 0; i < std::ssize(digits); ++i)",
			"        {",
			"            if (i < std::ssize(b))",
			"            {",
			"                digits[i] += b[i];",
			"            }",
			"            if (digits[i] >= BASE)",
			"            {",
			"                digits[i] -= BASE;",
			"                if (i == std::ssize(digits) - 1)",
			"                {",
			"                    digits.push_back(0);",
			"                }",
			"                digits[i + 1] += 1;",
			"            }",
			"            else if (i >= std::ssize(b))",
			"            {",
			"                break;",
			"            }",
			"        }",
			"        trim();",
			"    }",
			"",
			"    void trim()",
			"    {",
			"        while (digits.back() == 0 && std::ssize(digits) > 1)",
			"        {",
			"            digits.pop_back();",
			"        }",
			"        if (std::ssize(digits) == 1 && digits.back() == 0)",
			"        {",
			"            sign = 0;",
			"        }",
			"    }",
			"",
			"    void sub(const std::vector<u32> &b)",
			"    {",
			"        int ret = cmp(b);",
			"        if (ret == 0)",
			"        {",
			"            sign = 0;",
			"        }",
			"        else if (ret > 0)",
			"        {",
			"            u32 carry = 0;",
			"            for (int i = 0; i < std::ssize(digits); ++i)",
			"            {",
			"                u32 minuend = carry;",
			"                if (i < std::ssize(b))",
			"                {",
			"                    minuend += b[i];",
			"                }",
			"                else if (carry == 0)",
			"                {",
			"                    break;",
			"                }",
			"                ",
			"                if (digits[i] < minuend)",
			"                {",
			"                    digits[i] = BASE + digits[i] - minuend;",
			"                    carry = 1;",
			"                }",
			"                else",
			"                {",
			"                    digits[i] = digits[i] - minuend;",
			"                    carry = 0;",
			"                }",
			"            }",
			"        }",
			"        else",
			"        {",
			"            sign = -sign;  // 注意符号取反",
			"            digits.resize(b.size());",
			"            u32 carry = 0;",
			"            for (int i = 0; i < std::ssize(digits); ++i)",
			"            {",
			"                u32 b_val = (i < std::ssize(b)) ? b[i] : 0;",
			"                if (b_val < digits[i] + carry)",
			"                {",
			"                    digits[i] = BASE + b_val - digits[i] - carry;",
			"                    carry = 1;",
			"                }",
			"                else",
			"                {",
			"                    digits[i] = b_val - digits[i] - carry;",
			"                    carry = 0;",
			"                }",
			"            }",
			"        }",
			"        trim();",
			"    }",
			"",
			"    void mul(const std::vector<u32> &b)",
			"    {",
			"        int n = std::ssize(digits);",
			"        int m = std::ssize(b);",
			"        std::vector<u32> c(n + m);",
			"        u64 temp = 0;",
			"        for (int i = 0; i < n + m - 1; ++i)",
			"        {",
			"            for (int j = std::max(i - n + 1, 0); j <= std::min(i, m - 1); ++j)",
			"            {",
			"                temp += static_cast<u64>(b[j]) * static_cast<u64>(digits[i - j]);",
			"            }",
			"            c[i] = temp % BASE;",
			"            temp /= BASE;",
			"        }",
			"        if (temp != 0)",
			"        {",
			"            c[n + m - 1] = static_cast<u32>(temp);",
			"        }",
			"        digits = c;",
			"        trim();",
			"    }",
			"",
			"    void mul_fft(const std::vector<u32> &b)",
			"    {",
			"        FFT::mul(digits, b);",
			"        trim();",
			"    }",
			"",
			"    void div2()",
			"    {",
			"        for (int i = std::ssize(digits) - 1; i >= 0; i--)",
			"        {",
			"            if ((digits[i] & 1) && i)",
			"            {",
			"                digits[i - 1] += BASE;",
			"            }",
			"            digits[i] >>= 1;",
			"        }",
			"        trim();",
			"    }",
			"",
			"    void div(i64 b)",
			"    {",
			"        if (b == 0)",
			"        {",
			"            throw DivisionByZeroError();",
			"        }",
			"        if (*this == 0)",
			"        {",
			"            return;",
			"        }",
			"        if (b > std::numeric_limits<int>::max())",
			"        {",
			"            *this = newton_divmod(b).first;",
			"            return;",
			"        }",
			"        sign = ((static_cast<i64>(sign) * b) > 0) ? 1 : -1;",
			"        if (b == 2 || b == -2)",
			"        {",
			"            div2();",
			"            return;",
			"        }",
			"        u64 cur = 0;",
			"        u64 divisor = std::abs(b);",
			"        for (int i = std::ssize(digits) - 1; i >= 0; --i)",
			"        {",
			"            cur = cur * BASE + digits[i];",
			"            digits[i] = static_cast<u32>(cur / divisor);",
			"            cur %= divisor;",
			"        }",
			"        trim();",
			"    }",
			"",
			"    int cmp(const std::vector<u32> &b) const",
			"    {",
			"        if (std::ssize(digits) > std::ssize(b))",
			"        {",
			"            return 1;",
			"        }",
			"        if (std::ssize(digits) < std::ssize(b))",
			"        {",
			"            return -1;",
			"        }",
			"        for (int i = std::ssize(digits) - 1; i >= 0; --i)",
			"        {",
			"            if (digits[i] > b[i])",
			"            {",
			"                return 1;",
			"            }",
			"            if (digits[i] < b[i])",
			"            {",
			"                return -1;",
			"            }",
			"        }",
			"        return 0;",
			"    }",
			"",
			"    int cmpWithSign(const bint &b) const",
			"    {",
			"        if (sign != b.sign)",
			"        {",
			"            return sign > b.sign ? 1 : -1;",
			"        }",
			"        if (sign == 0)",
			"        {",
			"            return 0;",
			"        }",
			"        return sign * cmp(b.digits);",
			"    }",
			"",
			"    bint abs() const",
			"    {",
			"        bint res = *this;",
			"        res.sign = 1;",
			"        return res;",
			"    }",
			"",
			"    int size() const",
			"    {",
			"        return std::ssize(digits);",
			"    }",
			"",
			"    void resize(int n)",
			"    {",
			"        digits.resize(n);",
			"    }",
			"",
			"    bint move_l(int d) const",
			"    {",
			"        if (sign == 0)",
			"        {",
			"            return *this;",
			"        }",
			"        if (d == 0)",
			"        {",
			"            return *this;",
			"        }",
			"        bint res;",
			"        res.sign = sign;",
			"        res.digits.reserve(size() + d + 1);",
			"        for (int i = 1; i <= d; ++i)",
			"        {",
			"            res.digits.push_back(0);",
			"        }",
			"        for (int i = 0; i < size(); ++i)",
			"        {",
			"            res.digits.push_back(digits[i]);",
			"        }",
			"        return res;",
			"    }",
			"",
			"    bint move_r(int d) const",
			"    {",
			"        if (sign == 0 || d >= size())",
			"        {",
			"            return 0;",
			"        }",
			"        if (d == 0)",
			"        {",
			"            return *this;",
			"        }",
			"        bint res;",
			"        res.sign = sign;",
			"        res.digits.reserve(size() - d + 1);",
			"        for (int i = d; i < size(); ++i)",
			"        {",
			"            res.digits.push_back(digits[i]);",
			"        }",
			"        return res;",
			"    }",
			"",
			"    bint newton_inv(int n) const",
			"    {",
			"        if (*this == 0)",
			"        {",
			"            throw DivisionByZeroError();",
			"        }",
			"        if (std::min(size(), n - size()) <= NEWTON_MIN_LEVEL)",
			"        {",
			"            bint a;",
			"            a.resize(n + 1);",
			"            a.sign = 1;",
			"            a.digits.back() = 1;",
			"            return a.divmod(*this, false).first;",
			"        }",
			"        int k = (n - size() + 2) >> 1;",
			"        int k2 = k > size() ? 0 : size() - k;",
			"        bint x = move_r(k2);",
			"        int n2 = k + x.size();",
			"        bint y = x.newton_inv(n2);",
			"        bint a = y + y;",
			"        bint b = (*this) * y * y;",
			"        return a.move_l(n - n2 - k2) - b.move_r(2 * (n2 + k2) - n) - 1;",
			"    }",
			"",
			"    std::pair<bint, bint> newton_divmod(const bint &x) const",
			"    {",
			"        int k = size() - x.size() + 2;",
			"        int k2 = k > x.size() ? 0 : x.size() - k;",
			"        bint x2 = x.move_r(k2);",
			"        if (k2 != 0)",
			"        {",
			"            x2 += 1;",
			"        }",
			"        int n2 = k + x2.size();",
			"        bint u = (*this) * x2.newton_inv(n2);",
			"        bint q = u.move_r(n2 + k2);",
			"        bint r = (*this) - q * x;",
			"        while (r >= x)",
			"        {",
			"            q += 1;",
			"            r -= x;",
			"        }",
			"        return {q, r};",
			"    }",
			"",
			"    std::pair<bint, bint> divmod(const bint &x, bool enable_newton = true) const",
			"    {",
			"        if (x == 0)",
			"        {",
			"            throw DivisionByZeroError();",
			"        }",
			"        if (sign == 0)",
			"        {",
			"            return {0, 0};",
			"        }",
			"        bint a = abs();",
			"        bint b = x.abs();",
			"        if (a < b)",
			"        {",
			"            return {0, sign == 1 ? a : -a};",
			"        }",
			"        if (enable_newton && size() > NEWTON_LIMIT)",
			"        {",
			"            return newton_divmod(x);",
			"        }",
			"        int t = BASE / (x.digits.back() + 1);",
			"        a *= t;",
			"        b *= t;",
			"        int n = a.size();",
			"        int m = b.size();",
			"        bint q = 0;",
			"        bint r = 0;",
			"        q.resize(n);",
			"        for (int i = n - 1; i >= 0; --i)",
			"        {",
			"            r *= BASE;",
			"            r += a.digits[i];",
			"            int d1 = m - 1 < r.size() ? r.digits[m] : 0;",
			"            int d2 = m - 2 < r.size() ? r.digits[m - 1] : 0;",
			"            int d = (static_cast<u64>(d1) * BASE + d2) / b.digits[m - 1];",
			"            r -= b * d;",
			"            while (r.sign < 0)",
			"            {",
			"                r += b;",
			"                d--;",
			"            }",
			"            q.digits[i] = d;",
			"        }",
			"        q.sign = sign * x.sign;",
			"        q.trim();",
			"        return {q, r / t};",
			"    }",
			"",
			"    std::vector<char> to_bin() const ",
			"    { ",
			"        std::vector<char> ret;",
			"        for (bint x = *this; x != 0; x.div2())",
			"        {",
			"            ret.emplace_back(x.digits[0] & 1);",
			"        }",
			"        return ret;",
			"    }",
			"",
			"    template<class T>",
			"    void bin_op(const bint &b, const T &op)",
			"    {",
			"        std::vector<char> x = to_bin();",
			"        std::vector<char> y = b.to_bin();",
			"        int l1 = std::ssize(x);",
			"        int l2 = std::ssize(y);",
			"        int len = std::max(l1, l2);",
			"        std::vector<char> ret(len, 0);",
			"        for (int i = 0; i < len; ++i)",
			"        {",
			"            ret[i] = op(i < l1 ? x[i] : 0, i < l2 ? y[i] : 0);",
			"        }",
			"        std::reverse(ret.begin(), ret.end());",
			"        *this = ret;",
			"    }",
			"",
			"public:",
			"    bint() {}",
			"",
			"    bint(i64 x)",
			"    {",
			"        *this = x;",
			"    }",
			"",
			"    bint(const std::string &s)",
			"    {",
			"        *this = s;",
			"    }",
			"",
			"    bint(const std::vector<char> &b)",
			"    {",
			"        *this = b;",
			"    }",
			"",
			"    bint &operator=(i64 x)",
			"    {",
			"        if (x == 0)",
			"        {",
			"            sign = 0;",
			"            return *this;",
			"        }",
			"        if (x == std::numeric_limits<i64>::min())",
			"        {",
			"            *this = \"-9223372036854775808\";",
			"            return *this;",
			"        }",
			"        sign = (x > 0) ? 1 : -1;",
			"        digits.clear();",
			"        u64 n = std::abs(x);",
			"        do",
			"        {",
			"            digits.push_back(n % BASE);",
			"            n /= BASE;",
			"        } while (n != 0);",
			"        return *this;",
			"    }",
			"",
			"    bint &operator=(const std::string &s)",
			"    {",
			"        if (s.empty())",
			"        {",
			"            return *this = 0;",
			"        }",
			"        int start = 0;",
			"        sign = 1;",
			"        if (s[0] == '-')",
			"        {",
			"            sign = -1;",
			"            ++start;",
			"        }",
			"        digits.clear();",
			"        for (int i = std::ssize(s) - BIT; i >= start - BIT + 1; i -= BIT)",
			"        {",
			"            u32 temp = 0;",
			"            for (int j = std::max(start, i); j < i + BIT; j++)",
			"            {",
			"                temp = temp * 10 + (s[j] - '0');",
			"            }",
			"            digits.push_back(temp);",
			"        }",
			"        if (size() == 1 && digits.back() == 0)",
			"        {",
			"            sign = 0;",
			"        }",
			"        return *this;",
			"    }",
			"",
			"    bint &operator=(const std::vector<char> &b)",
			"    { ",
			"        // high -> low",
			"        *this = 0;",
			"        bint pow2 = 1;",
			"        for (int i = std::ssize(b) - 1; i >= 0; --i, pow2 += pow2)",
			"        {",
			"            if (b[i])",
			"            {",
			"                *this += pow2;",
			"            }",
			"        }",
			"        return *this;",
			"    }",
			"",
			"    bool operator==(const bint &b) const",
