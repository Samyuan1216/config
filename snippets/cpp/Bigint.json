{
	"Print to console": {
		"scope": "cpp",
		"prefix": "Bigint",
		"body": [
			"class Bigint",
			"{",
			"    static constexpr int BASE = 1e9;",
			"    static constexpr int WIDTH = 9;",
			"    std::vector<int> num;",
			"    bool neg;",
			"",
			"    void _trim()",
			"    {",
			"        while (num.size() > 1 && num.back() == 0)",
			"        {",
			"            num.pop_back();",
			"        }",
			"",
			"        if (num.empty())",
			"        {",
			"            num.push_back(0);",
			"        }",
			"",
			"        if (num.size() == 1 && num[0] == 0)",
			"        {",
			"            neg = false;",
			"        }",
			"    }",
			"",
			"    std::strong_ordering _cmp_abs(const Bigint& rhs) const",
			"    {",
			"        if (num.size() != rhs.num.size())",
			"        {",
			"            return num.size() <=> rhs.num.size();",
			"        }",
			"",
			"        for (int i = num.size() - 1; i >= 0; --i)",
			"        {",
			"            if (num[i] != rhs.num[i])",
			"            {",
			"                return num[i] <=> rhs.num[i];",
			"            }",
			"        }",
			"",
			"        return std::strong_ordering::equal;",
			"    }",
			"",
			"    void _add_abs(const Bigint& rhs)",
			"    {",
			"        if (num.size() < rhs.num.size())",
			"        {",
			"            num.resize(rhs.num.size(), 0);",
			"        }",
			"",
			"        i64 carry = 0;",
			"        for (size_t i = 0; i < rhs.num.size() || carry; ++i)",
			"        {",
			"            if (i == num.size())",
			"            {",
			"                num.push_back(0);",
			"            }",
			"",
			"            i64 sum = num[i] + carry + (i < rhs.num.size() ? rhs.num[i] : 0);",
			"            carry = sum >= BASE;",
			"            num[i] = sum % BASE;",
			"        }",
			"    }",
			"",
			"    void _sub_abs(const Bigint& rhs)",
			"    {",
			"        i64 borrow = 0;",
			"        for (size_t i = 0; i < rhs.num.size() || borrow; ++i)",
			"        {",
			"            i64 diff = num[i] - borrow - (i < rhs.num.size() ? rhs.num[i] : 0);",
			"            borrow = diff < 0;",
			"            num[i] = borrow ? diff + BASE : diff;",
			"        }",
			"",
			"        _trim();",
			"    }",
			"public:",
			"    Bigint() : num{0}, neg(false) {}",
			"",
			"    Bigint& operator=(const Bigint& rhs) = default;",
			"    ",
			"    template<std::integral T>",
			"    Bigint& operator=(T x)",
			"    {",
			"        if constexpr (std::is_signed_v<T>)",
			"        {",
			"            if (x < 0)",
			"            {",
			"                neg = true;",
			"                x = -x;",
			"            }",
			"            else",
			"            {",
			"                neg = false;",
			"            }",
			"        }",
			"        else",
			"        {",
			"            neg = false;",
			"        }",
			"",
			"        num.clear();",
			"        if (x == 0)",
			"        {",
			"            num.push_back(0);",
			"        }",
			"        else",
			"        {",
			"            while (x > 0)",
			"            {",
			"                num.push_back(x % BASE);",
			"                x /= BASE;",
			"            }",
			"        }",
			"",
			"        return *this;",
			"    }",
			"",
			"    Bigint& operator=(const std::string& s)",
			"    {",
			"        if (s.empty())",
			"        {",
			"            *this = 0;",
			"            return *this;",
			"        }",
			"",
			"        int start = 0;",
			"        neg = false;",
			"        if (s[0] == '-')",
			"        {",
			"            neg = true;",
			"            start = 1;",
			"        }",
			"        else if (s[0] == '+')",
			"        {",
			"            start = 1;",
			"        }",
			"",
			"        int n = s.length();",
			"        num.clear();",
			"        num.reserve((n - start + WIDTH - 1) / WIDTH);",
			"        for (int i = n; i > start; i -= WIDTH)",
			"        {",
			"            int sub_start = std::max(start, i - WIDTH);",
			"            int val = 0;",
			"            for (int j = sub_start; j < i; ++j)",
			"            {",
			"                val = val * 10 + (s[j] - '0');",
			"            }",
			"",
			"            num.push_back(val);",
			"        }",
			"",
			"        _trim();",
			"        return *this;",
			"    }",
			"",
			"    template<std::integral T>",
			"    Bigint(T x)",
			"    {",
			"        *this = x; // 现在这行代码是安全的，因为有了 operator=(T)",
			"    }",
			"",
			"    Bigint(const std::string& s)",
			"    {",
			"        *this = s;",
			"    }",
			"",
			"    std::strong_ordering operator<=>(const Bigint& rhs) const",
			"    {",
			"        if (neg != rhs.neg)",
			"        {",
			"            return neg ? std::strong_ordering::less : std::strong_ordering::greater;",
			"        }",
			"",
			"        std::strong_ordering abs_cmp = _cmp_abs(rhs);",
			"        return neg ? (0 <=> abs_cmp) : abs_cmp;",
			"    }",
			"",
			"    bool operator==(const Bigint& rhs) const",
			"    {",
			"        return neg == rhs.neg && num == rhs.num;",
			"    }",
			"",
			"    Bigint operator-() const",
			"    {",
			"        if (num.size() == 1 && num[0] == 0)",
			"        {",
			"            return *this;",
			"        }",
			"",
			"        Bigint res = *this;",
			"        res.neg = !res.neg;",
			"",
			"        return res;",
			"    }",
			"",
			"    Bigint& operator+=(const Bigint& rhs)",
			"    {",
			"        if (neg == rhs.neg)",
			"        {",
			"            _add_abs(rhs);",
			"        }",
			"        else",
			"        {",
			"            if (_cmp_abs(rhs) >= 0)",
			"            {",
			"                _sub_abs(rhs);",
			"            }",
			"            else",
			"            {",
			"                Bigint temp = rhs;",
			"                temp._sub_abs(*this);",
			"                *this = temp;",
			"            }",
			"        }",
			"",
			"        return *this;",
			"    }",
			"",
			"    Bigint& operator-=(const Bigint& rhs)",
			"    {",
			"        if (neg != rhs.neg)",
			"        {",
			"            _add_abs(rhs);",
			"        }",
			"        else",
			"        {",
			"            if (_cmp_abs(rhs) >= 0)",
			"            {",
			"                _sub_abs(rhs);",
			"            }",
			"            else",
			"            {",
			"                Bigint temp = rhs;",
			"                temp._sub_abs(*this);",
			"                *this = temp;",
			"                neg = !neg;",
			"            }",
			"        }",
			"",
			"        return *this;",
			"    }",
			"",
			"    Bigint& operator*=(const Bigint& rhs)",
			"    {",
			"        if ((num.size() == 1 && num[0] == 0) || (rhs.num.size() == 1 && rhs.num[0] == 0))",
			"        {",
			"            *this = 0;",
			"            return *this;",
			"        }",
			"",
			"        std::vector<int> res(num.size() + rhs.num.size(), 0);",
			"        for (size_t i = 0; i < num.size(); ++i)",
			"        {",
			"            u64 carry = 0;",
			"            for (size_t j = 0; j < rhs.num.size() || carry; ++j)",
			"            {",
			"                u64 cur = res[i + j] + (u64)num[i] * (j < rhs.num.size() ? rhs.num[j] : 0) + carry;",
			"                res[i + j] = cur % BASE;",
			"                carry = cur / BASE;",
			"            }",
			"        }",
			"",
			"        num = res;",
			"        neg = (neg != rhs.neg);",
			"",
			"        _trim();",
			"        return *this;",
			"    }",
			"",
			"    std::pair<Bigint, Bigint> div_mod(const Bigint& rhs) const",
			"    {",
			"        if (rhs == 0)",
			"        {",
			"            throw std::runtime_error(\"Division by zero\");",
			"        }",
			"",
			"        if (_cmp_abs(rhs) < 0)",
			"        {",
			"            return {0, *this};",
			"        }",
			"",
			"        Bigint val_abs = *this;",
			"        val_abs.neg = false;",
			"        Bigint rhs_abs = rhs;",
			"        rhs_abs.neg = false;",
			"        Bigint quo;",
			"        quo.num.resize(num.size());",
			"        ",
			"        Bigint rem = 0; ",
			"        for (int i = num.size() - 1; i >= 0; i--)",
			"        {",
			"            if (rem.num.size() == 1 && rem.num[0] == 0)",
			"            {",
			"                rem.num[0] = val_abs.num[i];",
			"            }",
			"            else",
			"            {",
			"                rem.num.insert(rem.num.begin(), val_abs.num[i]);",
			"            }",
			"",
			"            rem._trim();",
			"",
			"            int left = 0, right = BASE - 1;",
			"            int best_q = 0;",
			"            while (left <= right)",
			"            {",
			"                int mid = left + (right - left) / 2;",
			"                ",
			"                Bigint prod = rhs_abs;",
			"                if (mid == 0)",
			"                {",
			"                    prod = 0;",
			"                }",
			"                else",
			"                {",
			"                    u64 carry = 0;",
			"                    for (auto& x : prod.num)",
			"                    {",
			"                        u64 tmp = (u64)x * mid + carry;",
			"                        x = tmp % BASE;",
			"                        carry = tmp / BASE;",
			"                    }",
			"",
			"                    if (carry)",
			"                    {",
			"                        prod.num.push_back(carry);",
			"                    }",
			"                }",
			"",
			"                prod._trim();",
			"                if (prod._cmp_abs(rem) <= 0)",
			"                {",
			"                    best_q = mid;",
			"                    left = mid + 1;",
			"                }",
			"                else",
			"                {",
			"                    right = mid - 1;",
			"                }",
			"            }",
			"",
			"            quo.num[i] = best_q;",
			"            Bigint prod = rhs_abs;",
			"            if (best_q == 0)",
			"            {",
			"                prod = 0;",
			"            }",
			"            else",
			"            {",
			"                u64 carry = 0;",
			"                for (auto& x : prod.num)",
			"                {",
			"                    u64 tmp = (u64)x * best_q + carry;",
			"                    x = tmp % BASE;",
			"                    carry = tmp / BASE;",
			"                }",
			"",
			"                if (carry)",
			"                {",
			"                    prod.num.push_back(carry);",
			"                }",
			"            }",
			"",
			"            prod._trim();",
			"            rem._sub_abs(prod);",
			"        }",
			"",
			"        quo.neg = (neg != rhs.neg);",
			"        quo._trim();",
			"        rem.neg = neg;",
			"        rem._trim();",
			"",
			"        return {quo, rem};",
			"    }",
			"",
			"    Bigint& operator/=(const Bigint& rhs)",
			"    {",
			"        *this = div_mod(rhs).first;",
			"        return *this;",
			"    }",
			"",
			"    Bigint& operator%=(const Bigint& rhs)",
			"    {",
			"        *this = div_mod(rhs).second;",
			"        return *this;",
			"    }",
			"",
			"    friend Bigint operator+(Bigint lhs, const Bigint& rhs)",
			"    {",
			"        return lhs += rhs;",
			"    }",
			"",
			"    friend Bigint operator-(Bigint lhs, const Bigint& rhs)",
			"    {",
			"        return lhs -= rhs;",
			"    }",
			"",
			"    friend Bigint operator*(Bigint lhs, const Bigint& rhs)",
			"    {",
			"        return lhs *= rhs;",
			"    }",
			"",
			"    friend Bigint operator/(const Bigint& lhs, const Bigint& rhs)",
			"    {",
			"        return lhs.div_mod(rhs).first;",
			"    }",
			"",
			"    friend Bigint operator%(const Bigint& lhs, const Bigint& rhs)",
			"    {",
			"        return lhs.div_mod(rhs).second;",
			"    }",
			"",
			"    friend std::ostream& operator<<(std::ostream& os, const Bigint& x)",
			"    {",
			"        if (x.neg && !(x.num.size() == 1 && x.num[0] == 0))",
			"        {",
			"            os << '-';",
			"        }",
			"",
			"        os << (x.num.empty() ? 0 : x.num.back());",
			"        for (int i = (int)x.num.size() - 2; i >= 0; i--)",
			"        {",
			"            os << std::setw(WIDTH) << std::setfill('0') << x.num[i];",
			"        }",
			"",
			"        return os;",
			"    }",
			"",
			"    friend std::istream& operator>>(std::istream& is, Bigint& x)",
			"    {",
			"        std::string s;",
			"        is >> s;",
			"        x = s;",
			"",
			"        return is;",
			"    }",
			"};"
		],
		"description": "高精度整数"
	}
}
