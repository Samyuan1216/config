{
	"Print to console": {
		"scope": "cpp",
		"prefix": "Descartes_Tree",
		"body": [
			"template<typename T = int, typename Cmp = std::less<T>>",
			"class Descartes_Tree",
			"{",
			"    Cmp compare;",
			"public:",
			"    const std::vector<T> &arr;",
			"    std::vector<int> left;",
			"    std::vector<int> right;",
			"    std::vector<int> stack;",
			"    int n;",
			"    int root = -1;",
			"",
			"    Descartes_Tree(const std::vector<T> &input, int size) : arr(input), left(size, -1), right(size, -1), stack(size), n(size)",
			"    {",
			"        for (int i = 0, top = 0, pos = 0; i < n; ++i)",
			"        {",
			"            pos = top;",
			"            while (pos > 0 && compare(arr[stack[pos - 1]], arr[i]))",
			"            {",
			"                --pos;",
			"            }",
			"",
			"            if (pos > 0)",
			"            {",
			"                right[stack[pos - 1]] = i;",
			"            }",
			"",
			"            if (pos < top)",
			"            {",
			"                left[i] = stack[pos];",
			"            }",
			"",
			"            stack[pos] = i;",
			"            top = pos + 1;",
			"        }",
			"",
			"        if (n > 0)",
			"        {",
			"            root = stack[0];",
			"        }",
			"    }",
			"};"
		],
		"description": "笛卡尔树"
	}
}
