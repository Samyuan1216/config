{
	"Print to console": {
		"scope": "cpp",
		"prefix": "dsu",
		"body": [
			"class DSU",
			"{",
			"    std::vector<int> father, size;",
			"public:",
			"    DSU(int n): father(n + 1), size(n + 1, 1)",
			"    {",
			"        for (int i = 1; i <= n; ++i)",
			"        {",
			"            father[i] = i;",
			"        }",
			"    }",
			"",
			"    int find(int i)",
			"    {",
			"        if (i != father[i])",
			"        {",
			"            father[i] = find(father[i]);",
			"        }",
			"",
			"        return father[i];",
			"    }",
			"",
			"    void merge(int x, int y)",
			"    {",
			"        int fx = find(x), fy = find(y);",
			"        if (fx == fy)",
			"        {",
			"            return;",
			"        }",
			"",
			"        if (size[fx] < size[fy])",
			"        {",
			"            std::swap(fx, fy);",
			"        }",
			"",
			"        father[fy] = fx;",
			"        size[fx] += size[fy];",
			"    }",
			"",
			"    int get_size(int i)",
			"    {",
			"        return size[find(i)];",
			"    }",
			"",
			"    bool same(int x, int y)",
			"    {",
			"        return find(x) == find(y);",
			"    }",
			"};"
		],
		"description": "并查集"
	}
}
