{
	"Print to console": {
		"scope": "cpp",
		"prefix": "matrix_power",
		"body": [
			"auto mat_mul = [](auto &&a, auto &&b)",
			"{",
			"    int n = a.size(), t = a[0].size(), m = b[0].size();",
			"    auto ans = std::vector(n, std::vector<int>(m));",
			"",
			"    for (int i = 0; i < n; ++i)",
			"    {",
			"        for (int k = 0; k < t; ++k)",
			"        {",
			"            auto aik =  a[i][k];",
			"            for (int j = 0; j < m; ++j)",
			"            {",
			"                ans[i][j] += aik * b[k][j];",
			"            }",
			"        }",
			"    }",
			"",
			"    return ans;",
			"};",
			"",
			"auto mat_power = [&](auto &&mat, int n)",
			"{",
			"    int size = mat.size();",
			"    auto ans = std::vector(size, std::vector<int>(size));",
			"    for (int i = 0; i < size; ++i)",
			"    {",
			"        ans[i][i] = 1;",
			"    }",
			"",
			"    while (n > 0)",
			"    {",
			"        if (n & 1)",
			"        {",
			"            ans = mat_mul(ans, mat);",
			"        }",
			"",
			"        mat = mat_mul(mat, mat);",
			"        n >>= 1;",
			"    }",
			"",
			"    return ans;",
			"};"
		],
		"description": "矩阵快速幂"
	}
}
