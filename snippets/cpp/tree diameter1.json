		"body": [
			"int start, end, diameter;",
			"auto dist = std::vector<int>(n + 1), last = std::vector<int>(n + 1);",
			"auto tree_diameter = [&]()",
			"{",
			"    auto dfs = [&](auto &&self, int u, int f, int w) -> void",
			"    {",
			"        last[u] = f, dist[u] = dist[f] + w;",
			"        for (auto &[v, vw]: g[u])",
			"        {",
			"            if (v != f)",
			"            {",
			"                self(self, v, u, vw);",
			"            }",
			"        }",
			"    };",
			"",
			"    dfs(dfs, 1, 0, 0);",
			"",
			"    start = 1;",
			"    for (int i = 2; i <= n; ++i)",
			"    {",
			"        if (dist[i] > dist[start])",
			"        {",
			"            start = i;",
			"        }",
			"    }",
			"",
			"    dfs(dfs, start, 0, 0);",
			"",
			"    end = 1;",
			"    for (int i = 2; i <= n; ++i)",
			"    {",
			"        if (dist[i] > dist[end])",
			"        {",
			"            end = i;",
			"        }",
			"    }",
			"",
			"    diameter = dist[end];",
			"};"
		],
