{
	"Print to console": {
		"scope": "cpp",
		"prefix": "fact",
		"body": [
			"auto get_fact = [&](int n)",
			"{",
			"    auto fac = std::vector<int>(n + 1);",
			"",
			"    fac[0] = fac[1] = 1;",
			"    for (int i = 2; i <= n; ++i)",
			"    {",
			"        fac[i] = i * fac[i - 1];",
			"    }",
			"",
			"    return fac;",
			"};"
		],
		"description": "阶乘表"
	}
}
