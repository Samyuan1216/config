{
	"Print to console": {
		"scope": "cpp",
		"prefix": "C1",
		"body": [
			"auto power = [&](mint x, int n)",
			"{",
			"    mint ans = 1;",
			"    while (n > 0)",
			"    {",
			"        if (n & 1)",
			"        {",
			"            ans = ans * x;",
			"        }",
			"",
			"        x *= x;",
			"        n >>= 1;",
			"    }",
			"",
			"    return ans;",
			"};",
			"",
			"auto get_fact = [&](int n)",
			"{",
			"    auto fac = std::vector<mint>(n + 1);",
			"",
			"    fac[0] = fac[1] = 1;",
			"    for (int i = 2; i <= n; ++i)",
			"    {",
			"        fac[i] = i * fac[i - 1];",
			"    }",
			"",
			"    return fac;",
			"};",
			"",
			"auto get_inv = [&](int n)",
			"{",
			"    auto inv = std::vector<mint>(n + 1);",
			"",
			"    inv[n] = power(fac[n], mod - 2);",
			"    for (int i = n - 1; i >= 0; --i)",
			"    {",
			"        inv[i] = (i + 1) * inv[i + 1];",
			"    }",
			"",
			"    return inv;",
			"};",
			"",
			"auto C = [&](int n, int k)",
			"{",
			"    return (n < k? 0: fac[n] * inv[k] * inv[n - k]);",
			"};"
		],
		"description": "组合数"
	}
}
