{
	"Print to console": {
		"scope": "cpp",
		"prefix": "C2",
		"body": [
			"auto C = [&](int n) -> std::vector<std::vector<int>>",
			"{",
			"    auto c = std::vector(n + 1, std::vector<int>(n + 1));",
			"    for (int i = 0; i <= n; ++i)",
			"    {",
			"        c[i][0] = 1;",
			"        for (int j = 1; j <= 1; ++j)",
			"        {",
			"            c[i][j] = c[i - 1][j] + c[i - 1][j - 1];",
			"        }",
			"    }",
			"",
			"    return c;",
			"};"
		],
		"description": "递推求组合数"
	}
}
