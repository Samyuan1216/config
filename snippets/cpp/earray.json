{
	"Print to console": {
		"scope": "cpp",
		"prefix": "e_array",
		"body": [
			"auto z_array = [&](std::string &str)",
			"{",
			"    int n = str.length();",
			"    auto z = std::vector<int>(n);",
			"    z[0] = n;",
			"",
			"    for (int i = 1, c = 1, r = 1, len; i < n; ++i)",
			"    {",
			"        len = (r > i? std::min(r - i, z[i - c]): 0);",
			"        while (i + len < n && str[i + len] == str[len])",
			"        {",
			"            len++;",
			"        }",
			"",
			"        if (i + len > r)",
			"        {",
			"            r = i + len;",
			"            c = i;",
			"        }",
			"",
			"        z[i] = len;",
			"    }",
			"",
			"    return z;",
			"};",
			"",
			"auto e_array = [&](std::string &str1, std::string &str2, auto &z)",
			"{",
			"    int n = str1.length(), m = str2.length();",
			"    auto e = std::vector<int>(n);",
			"",
			"    for (int i = 0, c = 0, r = 0, len; i < n; ++i)",
			"    {",
			"        len = (r > i? std::min(r - i, z[i - c]): 0);",
			"        while (i + len < n && len < m && str1[i + len] == str2[len])",
			"        {",
			"            len++;",
			"        }",
			"",
			"        if (i + len > r)",
			"        {",
			"            r = i + len;",
			"            c = i;",
			"        }",
			"",
			"        e[i] = len;",
			"    }",
			"",
			"    return e;",
			"};"
		],
		"description": "e数组"
	}
}
