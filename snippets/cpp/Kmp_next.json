{
	"Print to console": {
		"scope": "cpp",
		"prefix": "Kmp_next",
		"body": [
			"auto next_array = [&](const auto &arr) -> std::vector<int>",
			"{",
			"    int n = std::ssize(arr);",
			"    if (n == 1)",
			"    {",
			"        return std::vector<int>{-1};",
			"    }",
			"",
			"    auto next = std::vector<int>(n);",
			"    next[0] = -1;",
			"",
			"    int i = 2, m = 0;",
			"    while (i < n)",
			"    {",
			"        if (arr[i - 1] == arr[m])",
			"        {",
			"            next[i++] = ++m;",
			"        }",
			"        else if (m > 0)",
			"        {",
			"            m = next[m];",
			"        }",
			"        else",
			"        {",
			"            next[i++] = 0;",
			"        }",
			"    }",
			"",
			"    return next;",
			"};"
		],
		"description": "kmp_next数组构建"
	}
}
