			"auto dfs = [&](auto &&self, int u, int f) -> void",
			"{",
			"    deep[u] = deep[f] + 1;",
			"    stjump[u][0] = f;",
			"    for (int p = 1; (1 << p) <= deep[u]; ++p)",
