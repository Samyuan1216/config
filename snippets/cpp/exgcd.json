{
	"Print to console": {
		"scope": "cpp",
		"prefix": "exgcd",
		"body": [
			"auto exgcd = [&](auto &&self, int a, int b) -> std::array<int, 3>",
			"{",
			"    if (b == 0)",
			"    {",
			"        return {a, 1, 0};",
			"    }",
			"    ",
			"    auto [d, x, y] = self(self, b, a % b);",
			"    return {d, y, x - y * (a / b)};",
			"};"
		],
		"description": "扩展欧几里得"
	}
}
