{
	"Print to console": {
		"scope": "cpp",
		"prefix": "Floyd",
		"body": [
			"auto floyd = [&](int n) -> void",
			"{",
			"    for (int k = 0; k < n; ++k)",
			"    {",
			"        for (int i = 0; i < n; ++i)",
			"        {",
			"            if (g[i][k] == 1e9)",
			"            {",
			"                continue;",
			"            }",
			"",
			"            for (int j = 0; j < n; ++j)",
			"            {",
			"                if (g[k][j] == 1e9)",
			"                {",
			"                    continue;",
			"                }",
			"",
			"                g[i][j] = std::min(g[i][j], g[i][k] + g[k][j]);",
			"            }",
			"        }",
			"    }",
			"};"
		],
		"description": "floyd"
	}
}
