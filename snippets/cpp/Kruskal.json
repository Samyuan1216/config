{
	"Print to console": {
		"scope": "cpp",
		"prefix": "Kruskal",
		"body": [
			"auto edges = std::vector(m, std::array<int, 3>());",
			"auto kruskal = [&]() -> std::optional<int>",
			"{",
			"    DSU set(n);",
			"    ranges::sort(edges);",
			"",
			"    int sum = 0, cnt = 0;",
			"    for (auto &[w, u, v]: edges)",
			"    {",
			"        if (!set.same(u, v))",
			"        {",
			"            set.merge(u, v);",
			"",
			"            ++cnt;",
			"            sum += w;",
			"        }",
			"    }",
			"",
			"    return (cnt == n - 1? std::optional(sum): std::nullopt);",
			"};"
		],
		"description": "kruskal"
	}
}
