{
	"Binary Search Real Universal": {
		"scope": "cpp",
		"prefix": "bs_real",
		"body": [
			"auto find = [&](auto l, auto r, bool find_first = true) -> std::optional<decltype(l)>",
			"{",
			"    for (int i = 0; i <= 60; ++i)",
			"    {",
			"        auto mid = std::midpoint(l, r);",
			"        if (check(mid))",
			"        {",
			"            find_first? (r = mid): (l = mid);",
			"        }",
			"        else",
			"        {",
			"            find_first? (l = mid): (r = mid);",
			"        }",
			"    }",
			"",
			"    return (find_first? r: l);",
			"};"
		],
		"description": "二分搜索 (实数域)"
	}
}
