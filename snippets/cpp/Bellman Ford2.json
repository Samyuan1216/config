{
	"Print to console": {
		"scope": "cpp",
		"prefix": "Bellman_Ford2",
		"body": [
			"auto bellman_ford = [&](int s) -> std::optional<std::vector<int>>",
			"{",
            "    std::vector<int> dist(n, 1e9);",
			"    dist[s] = 0;",
			"",
			"    for (int i = 1; i < n; ++i)",
			"    {",
			"        bool update = false;",
			"        for (int u = 0; u < n; ++u)",
			"        {",
			"            if (dist[u] == 1e9) continue;",
			"            for (int v = 0; v < n; ++v)",
			"            {",
			"                if (g[u][v] != 1e9 && dist[u] + g[u][v] < dist[v])",
			"                {",
			"                    dist[v] = dist[u] + g[u][v];",
			"                    update = true;",
			"                }",
			"            }",
			"        }",
			"",
			"        if (!update)",
			"        {",
			"            break;",
			"        }",
			"    }",
			"",
			"    for (int u = 0; u < n; ++u)",
			"    {",
			"        if (dist[u] == 1e9) continue;",
			"        for (int v = 0; v < n; ++v)",
			"        {",
			"            if (g[u][v] != lim<int>::max() && dist[u] + g[u][v] < dist[v])",
			"            {",
			"                return std::nullopt;",
			"            }",
			"        }",
			"    }",
			"",
			"    return dist;",
			"};"
		],
		"description": "Bellman-Ford(Adjacency Matrix)"
	}
}
